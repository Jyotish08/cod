{
  "$defs": {
    "Difficulty": {
      "enum": [
        "EASY",
        "MEDIUM",
        "HARD",
        "UNKNOWN"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "TestCaseContract": {
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "input_data": {
          "description": "Raw or serialized stdin/arguments for the test case",
          "title": "Input Data",
          "type": "string"
        },
        "expected_output": {
          "description": "Expected stdout or serialized return value",
          "title": "Expected Output",
          "type": "string"
        },
        "is_sample": {
          "default": false,
          "description": "True if visible to user in UI; False if hidden judge test",
          "title": "Is Sample",
          "type": "boolean"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "order_index": {
          "default": 0,
          "title": "Order Index",
          "type": "integer"
        }
      },
      "required": [
        "input_data",
        "expected_output"
      ],
      "title": "TestCaseContract",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "integer"
    },
    "slug": {
      "title": "Slug",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "difficulty": {
      "$ref": "#/$defs/Difficulty"
    },
    "statement_md": {
      "title": "Statement Md",
      "type": "string"
    },
    "constraints_md": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Constraints Md"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "templates": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Templates",
      "type": "object"
    },
    "sample_test_cases": {
      "items": {
        "$ref": "#/$defs/TestCaseContract"
      },
      "title": "Sample Test Cases",
      "type": "array"
    },
    "time_limit_ms": {
      "title": "Time Limit Ms",
      "type": "integer"
    },
    "memory_limit_kb": {
      "title": "Memory Limit Kb",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "slug",
    "title",
    "difficulty",
    "statement_md",
    "constraints_md",
    "tags",
    "templates",
    "sample_test_cases",
    "time_limit_ms",
    "memory_limit_kb"
  ],
  "title": "ProblemWorkspaceDTO",
  "type": "object"
}
